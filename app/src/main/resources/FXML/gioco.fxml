<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.geometry.Insets?>

<!-- Contenitore dell'intera schermata e dello sfondo -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg123058.GUI.GiocoController"
           fx:id="contenitoreGioco"
           stylesheets="@../CSS/stile.css">

    <!-- Comprende descrizione, scelte e titolo -->
    <StackPane fx:id="pannelloNarrativo"
               StackPane.alignment="BOTTOM_CENTER"
               maxHeight="-Infinity">

        <StackPane.margin>
            <Insets top="0" right="30" bottom="24" left="30"/>
        </StackPane.margin>

        <VBox maxHeight="-Infinity"
              spacing="8"
              styleClass="pannello-narrativo">

            <StackPane.margin>
                <Insets top="16"/>
            </StackPane.margin>

            <GridPane hgap="20">

                <columnConstraints>
                    <ColumnConstraints percentWidth="55"/>
                    <ColumnConstraints percentWidth="45"/>
                </columnConstraints>

                <ScrollPane GridPane.columnIndex="0"
                            fitToWidth="true"
                            prefHeight="110"
                            minHeight="110"
                            maxHeight="110"
                            hbarPolicy="NEVER"
                            vbarPolicy="NEVER"
                            styleClass="testo-narrativo">

                    <content>
                        <Label fx:id="descrizioneScena"
                               wrapText="true"
                               maxWidth="Infinity"
                               styleClass="descrizione-scena"/>
                    </content>

                </ScrollPane>

                <ScrollPane GridPane.columnIndex="1"
                            fitToWidth="true"
                            prefHeight="110"
                            minHeight="110"
                            maxHeight="110"
                            hbarPolicy="NEVER"
                            vbarPolicy="NEVER"
                            styleClass="testo-narrativo">

                    <content>
                        <VBox fx:id="contenitoreScelte" spacing="6"/>
                    </content>

                </ScrollPane>

            </GridPane>

        </VBox>

        <Label fx:id="titoloScena"
               StackPane.alignment="TOP_CENTER"
               maxWidth="400"
               wrapText="true"
               alignment="CENTER"
               styleClass="targhetta-titolo"/>

    </StackPane>

    <Button fx:id="pulsanteSalvaEdEsci"
            text="Salva ed Esci"
            onAction="#salvaEdEsci"
            StackPane.alignment="TOP_LEFT"
            styleClass="pulsante-scelta">

        <StackPane.margin>
            <Insets top="20" left="30"/>
        </StackPane.margin>

    </Button>

    <!-- Esterno al pannello narrativo -->
    <Button text="Inventario"
            onAction="#apriInventario"
            StackPane.alignment="TOP_RIGHT"
            styleClass="pulsante-scelta">

        <StackPane.margin>
            <Insets top="20" right="30"/>
        </StackPane.margin>

    </Button>

</StackPane>